{
  "name": "pet-detail",
  "type": "page",
  "url": "/pets/:id",
  "params": {
    "id": ""
  },
  "variables": [
    {
      "name": "petData",
      "type": "service",
      "id": "service"
    },
    {
      "name": "$state",
      "type": "service"
    },
    {
      "name": "$q",
      "type": "service"
    },
    {
      "name": "loading",
      "description": "Local request flag; only the current request token may clear it.",
      "type": "property",
      "value": "true"
    },
    {
      "name": "error",
      "description": "Safe service error message for non-404 failures, rendered as plain text.",
      "type": "property",
      "value": "null"
    },
    {
      "name": "notFound",
      "description": "True for invalid/missing IDs, absent records, or confirmed 404 responses.",
      "type": "property",
      "value": "false"
    },
    {
      "name": "pet",
      "description": "Read-only normalized detail; only id, name, category, status and tags are consumed.",
      "type": "property",
      "value": "null"
    },
    {
      "name": "sequence",
      "description": "Monotonic request token preventing stale result and finalizer writes.",
      "type": "property",
      "value": "0"
    },
    {
      "name": "lastRouteId",
      "description": "Last observed string ID; suppresses duplicate initial watch loads.",
      "type": "property",
      "value": "null"
    },
    {
      "name": "canRetry",
      "description": "Only valid integer-string route IDs can be retried or refreshed.",
      "type": "property",
      "value": "false"
    },
    {
      "name": "notFoundMessage",
      "description": "Distinct guidance for invalid links versus confirmed missing demo records.",
      "type": "property",
      "value": "''"
    },
    {
      "name": "statusColor",
      "description": "Semantic styling of reported API status; not an availability guarantee.",
      "type": "property",
      "value": "'default'"
    },
    {
      "name": "routeId",
      "description": "Reads the live UI-Router ID without numeric conversion. Bellini pageParameters provides the initial fallback.",
      "type": "method",
      "body": "const params = $ctrl.$state.params || {};\nconst raw = params.id !== undefined && params.id !== null ? params.id : ($ctrl.pageParameters && $ctrl.pageParameters.id);\nreturn raw === undefined || raw === null ? '' : String(raw);",
      "invokeOnLoad": false,
      "isAsync": false,
      "returnType": {
        "name": "any"
      },
      "parameters": [],
      "watch": []
    },
    {
      "name": "syncRoute",
      "description": "Loads direct links and changed route parameters, avoiding duplicate init/watch work.",
      "type": "method",
      "body": "const id = $ctrl.routeId();\nif ($ctrl.lastRouteId === id) { return; }\n$ctrl.lastRouteId = id;\nreturn $ctrl.loadPet(false);",
      "invokeOnLoad": true,
      "isAsync": false,
      "returnType": {
        "name": "any"
      },
      "parameters": [],
      "watch": [
        "$ctrl.$state.params.id",
        "$ctrl.pageParameters.id"
      ]
    },
    {
      "name": "loadPet",
      "description": "Loads only through petData. Every response, error and finalizer checks both sequence and current route. $q keeps updates digest-safe, including synchronous service exceptions.",
      "type": "method",
      "body": "const id = $ctrl.routeId();\nconst token = ++$ctrl.sequence;\n$ctrl.loading = true;\n$ctrl.error = null;\n$ctrl.notFound = false;\n$ctrl.pet = null;\n$ctrl.notFoundMessage = '';\n$ctrl.canRetry = /^-?\\d+$/.test(id) && id.length <= 100;\nif (!$ctrl.canRetry) {\n  $ctrl.loading = false;\n  $ctrl.notFound = true;\n  $ctrl.notFoundMessage = 'No matching pet: this link has a missing or invalid pet ID. Return to the Pet catalogue and choose a record.';\n  return;\n}\n// Capture the exact string ID; never use Number or parseInt for int64 routes.\nconst isCurrent = () => token === $ctrl.sequence && $ctrl.routeId() === id && $ctrl.$state.current.name === 'workspace.pet-detail';\nreturn $ctrl.$q.when().then(() => $ctrl.petData.getPet(id, !!force)).then(record => {\n  if (!isCurrent()) { return; }\n  if (!record) {\n    $ctrl.notFound = true;\n    $ctrl.notFoundMessage = 'No matching pet was returned for this ID. The public demo record may have changed or been removed. Retry or return to the Pet catalogue.';\n    return;\n  }\n  // Consume only the service contract's normalized fields; never mutate the service record.\n  $ctrl.pet = { id: record.id, name: record.name, category: record.category, status: record.status, tags: Array.isArray(record.tags) ? record.tags.slice() : [] };\n  const colors = { available: 'green', pending: 'yellow', sold: 'default' };\n  $ctrl.statusColor = colors[record.status] || 'default';\n}).catch(err => {\n  if (!isCurrent()) { return; }\n  if (err && (err.code === 'PET_NOT_FOUND' || err.status === 404)) {\n    $ctrl.notFound = true;\n    $ctrl.notFoundMessage = 'No matching pet (404). This ID was not found in the public Petstore demo. The record may have been removed or changed. Retry this ID or return to the Pet catalogue.';\n  } else {\n    $ctrl.error = (err && err.message) || 'We could not load this pet record. Please try again.';\n  }\n}).finally(() => {\n  if (isCurrent()) { $ctrl.loading = false; }\n});",
      "invokeOnLoad": false,
      "isAsync": false,
      "returnType": {
        "name": "any"
      },
      "parameters": [
        "force"
      ],
      "watch": []
    },
    {
      "name": "refresh",
      "description": "Force-refreshes the current valid route without clearing list caches.",
      "type": "method",
      "body": "if ($ctrl.loading || !$ctrl.canRetry) { return; }\nreturn $ctrl.loadPet(true);",
      "invokeOnLoad": false,
      "isAsync": false,
      "returnType": {
        "name": "any"
      },
      "parameters": [],
      "watch": []
    }
  ],
