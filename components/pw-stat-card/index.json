{
  "type": "custom-component",
  "name": "pw-stat-card",
  "description": "## Metric card\nReusable, full-width white metric card with a subtle border, restrained rounded corners, an uppercase muted label, a navy metric, and optional hint. Uses a built-in column box layout and Tailwind appearance utilities.\n\n### Inputs\n`label`, `value`, and `hint` are plain strings rendered as text, never injected HTML. `icon` is an optional string reserved for a supported core Icon renderer. Component discovery found no core Icon component, so this version intentionally omits the icon rather than substituting images, injected markup, or an interactive control.\n\n### Integration\nNo services or APIs. Width follows its parent; long content wraps on narrow screens. The metric remains a string so callers can supply currency, percentages, or other formatted values.",
  "children": [
    {
      "name": "section",
      "attributes": [
        {
          "property": "aria-label",
          "evaluate": "$ctrl.label || 'Metric'"
        }
      ],
      "classList": [
        "w-full",
        "min-w-0",
        "box-border",
        "rounded-xl",
        "border",
        "border-slate-200",
        "bg-white",
        "p-5",
        "sm:p-6",
        "text-slate-900"
      ],
      "layout": {
        "container": {
          "type": "box",
          "orientation": "column",
          "mainAxisAlignment": "flex-start",
          "crossAxisAlignment": "stretch",
          "gap": "0.5rem"
        }
      },
      "children": [
        {
          "name": "p",
          "classList": [
            "m-0",
            "text-xs",
            "font-medium",
            "uppercase",
            "tracking-wider",
            "leading-5",
            "text-slate-500",
            "break-words"
          ],
          "layout": {
            "cell": {
              "type": "box-item",
              "growFactor": 0,
              "shrinkFactor": 0,
              "mainSize": "auto"
            }
          },
          "children": [
            {
              "name": "text",
              "textContent": "$ctrl.label",
              "evaluate": true
            }
          ]
        },
        {
          "name": "p",
          "classList": [
            "m-0",
            "min-w-0",
            "text-3xl",
            "sm:text-4xl",
            "font-semibold",
            "tracking-tight",
            "leading-tight",
            "text-slate-900",
            "tabular-nums",
            "break-words"
          ],
          "layout": {
            "cell": {
              "type": "box-item",
              "growFactor": 0,
              "shrinkFactor": 0,
              "mainSize": "auto"
            }
          },
          "children": [
            {
              "name": "text",
              "textContent": "$ctrl.value",
              "evaluate": true
            }
          ]
        },
        {
          "name": "p",
          "classList": [
            "m-0",
            "text-sm",
            "font-normal",
            "leading-6",
            "text-slate-500",
            "break-words"
          ],
          "displayExpression": "$ctrl.hint",
          "layout": {
            "cell": {
              "type": "box-item",
              "growFactor": 0,
              "shrinkFactor": 0,
              "mainSize": "auto"
            }
          },
          "children": [
            {
              "name": "text",
              "textContent": "$ctrl.hint",
              "evaluate": true
            }
          ]
        }
      ],
      "comments": "Non-interactive metric surface. Built-in box layout owns spacing and arrangement; text nodes safely render all caller-provided strings. Icon intentionally omitted because no core Icon component was discovered."
    }
  ],
  "variables": [],
  "bindings": [
    {
      "name": "label",
      "type": "<",
      "default": "''",
      "description": "Short metric label, visually displayed in uppercase without changing the supplied text.",
      "visibleWhen": "",
      "label": "",
      "group": "",
      "example": "",
      "actions": [],
      "propertyType": "text",
      "autocomplete": [],
      "includeAssets": false
    },
    {
      "name": "value",
      "type": "<",
      "default": "''",
      "description": "Formatted metric string, such as 1,240 or $12,450.",
      "visibleWhen": "",
      "label": "",
      "group": "",
      "example": "",
      "actions": [],
      "propertyType": "text",
      "autocomplete": [],
      "includeAssets": false
    },
    {
      "name": "hint",
      "type": "<",
      "default": "''",
      "description": "Optional readable supporting text; omitted when empty.",
      "visibleWhen": "",
      "label": "",
      "group": "",
      "example": "",
      "actions": [],
      "propertyType": "text",
      "autocomplete": [],
      "includeAssets": false
    },
    {
      "name": "icon",
      "type": "<",
      "default": "''",
      "description": "Optional icon identifier. Reserved: no core Icon renderer is available, so currently not rendered. No images or HTML injection are used.",
      "visibleWhen": "",
      "label": "",
      "group": "",
      "example": "",
      "actions": [],
      "propertyType": "text",
      "autocomplete": [],
      "includeAssets": false
    }
  ],
  "modules": [],
  "styles": []
}